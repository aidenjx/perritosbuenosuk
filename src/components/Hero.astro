<section class="hero">
  <div class="container">
    <div class="hero-content">
      <span class="hero-label">Disclaimer</span>
      <h1 class="hero-title">
        Perritos.uk no está afiliado ni reconocido por Tony.
        <span class="hero-em">Somos solo fans.</span>
      </h1>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #8b1a1a 0%, #ce161a 40%, #e84a4a 100%);
    padding: clamp(3rem, 8vw, 6rem) 0;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 20px,
      rgba(0, 0, 0, 0.04) 20px,
      rgba(0, 0, 0, 0.04) 40px
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    max-width: var(--content-width);
    border-left: 3px solid rgba(255, 255, 255, 0.5);
    padding-left: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-size: clamp(1.1rem, 2vw + 0.5rem, 1.5rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .hero-em {
    display: block;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 0.25rem;
    font-style: italic;
  }
</style>
