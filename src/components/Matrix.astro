<section class="section matrix-section" id="matrix">
  <div class="container">
    <div class="matrix-card card">
      <div class="matrix-icon" aria-hidden="true">💬</div>
      <h2 class="matrix-title">Nuestro servidor de Matrix</h2>
      <p class="matrix-desc">
        Únete a la comunidad de perritos buenos. Charla, memes y mucho más.
      </p>
      <div class="matrix-actions">
        <button class="btn btn-primary btn-disabled" disabled>
          Únete ya
        </button>
        <span class="matrix-notice">No disponible aún</span>
      </div>
    </div>
  </div>
</section>

<style>
  .matrix-section {
    background: linear-gradient(180deg, var(--color-bg) 0%, #f0f0f0 100%);
  }

  .matrix-card {
    max-width: 32rem;
    margin: 0 auto;
    text-align: center;
    padding: clamp(2rem, 4vw, 3rem);
  }

  .matrix-icon {
    font-size: 3rem;
    margin-bottom: 0.75rem;
  }

  .matrix-title {
    margin-bottom: 0.5rem;
  }

  .matrix-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .matrix-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .matrix-notice {
    font-size: 0.85rem;
    color: var(--color-text-light);
    font-style: italic;
  }
</style>
