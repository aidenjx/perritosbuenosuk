---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AboutUs from "../components/AboutUs.astro";
import Gallery from "../components/Gallery.astro";
import Matrix from "../components/Matrix.astro";
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <a href="#main" class="sr-only">Ir al contenido principal</a>

        <Header />

        <main id="main">
            <Hero />
            <AboutUs />
            <Gallery />

            <section class="section mxlinux-section">
                <div class="container mxlinux-container">
                    <h2 class="mxlinux-title">Odiamos MX Linux</h2>
                    <p class="mxlinux-desc">
                        Una distribución que no recomendamos para nada. Lee por
                        qué.
                    </p>
                    <a
                        href="https://dev.to/kailyons/i-hate-mx-linux-distro-rant-ag8"
                        class="mxlinux-link"
                    >
                        Leer rant
                    </a>
                </div>
            </section>
        </main>

        <footer class="site-footer section">
            <div class="container">
                <div class="footer-inner">
                    <span class="footer-text">
                        &copy; {new Date().getFullYear()}
                        {SITE_TITLE} &mdash; Perritos buenos, honrados e inteligentes
                    </span>
                </div>
            </div>
        </footer>
    </body>
</html>

<style>
    .site-footer {
        background: var(--color-primary-dark);
        padding: 2rem 0 !important;
    }

    .footer-inner {
        text-align: center;
    }

    .footer-text {
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.9rem;
    }

    .mxlinux-section {
        background: linear-gradient(
            135deg,
            #1a1a2e 0%,
            #16213e 50%,
            #0f3460 100%
        );
        padding: clamp(3rem, 8vw, 5rem) 0;
        text-align: center;
    }

    .mxlinux-container {
        max-width: 36rem;
        margin: 0 auto;
    }

    .mxlinux-title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        color: #e94560;
        margin: 0 0 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .mxlinux-desc {
        font-size: 1.05rem;
        color: rgba(255, 255, 255, 0.7);
        margin: 0 0 1.5rem;
        line-height: 1.6;
    }

    .mxlinux-link {
        display: inline-block;
        background: #e94560;
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.75rem 2rem;
        border-radius: 6px;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        transition:
            background 0.2s,
            transform 0.15s;
    }

    .mxlinux-link:hover {
        background: #d63851;
        transform: translateY(-1px);
    }
</style>
